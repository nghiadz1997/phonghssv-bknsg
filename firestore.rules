rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userEmailLower() {
      return request.auth.token.email.lower();
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        userEmailLower() == "admin@nsg.edu.vn" ||
        userEmailLower() == "admin.hssv@namsaigon.edu.vn"
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") == "admin" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("position", "") in ["Trưởng Phòng", "Phó Trưởng Phòng"]
        )
      );
    }

    // Collection users: document ID = uid
    // Chỉ Trưởng Phòng / Phó Trưởng Phòng (admin) mới được thêm, chỉnh sửa thông tin / chức vụ và xóa tài khoản
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        isSuperAdmin() &&
        request.resource.data.role == "admin"
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Collection daily_reports: document ID = ${uid}_${date}
    // Nhân Viên / Chuyên Viên chỉ được đọc/thêm/chỉnh sửa báo cáo của chính mình;
    // Trưởng Phòng / Phó Trưởng Phòng xem tất cả, thêm, sửa và xóa được khi cần thiết.
    match /daily_reports/{reportId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        reportId.matches("^" + request.auth.uid + "_.*") ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow create, update: if isSignedIn() && (
        isAdmin() ||
        (
          request.resource.data.userId == request.auth.uid &&
          reportId == request.auth.uid + "_" + request.resource.data.date
        )
      );
      allow delete: if isAdmin();
    }
  }
}
